{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32 firmware",
      "type": "shell",
      "command": "make",
      "args": ["-j4"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test haptic controller",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$gcc"]
    }
  ]
}
